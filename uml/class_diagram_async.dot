digraph G {
  graph [rankdir=TB, nodesep=0.5, ranksep=0.6, fontname="Carlito", labelloc=t, label="Servers and OOP layer (class diagram)", fontsize=15];
  node  [shape=record, fontname="Carlito", fontsize=11, style=filled, fillcolor="#FFFFFF", color="#14213D"];
  edge  [fontname="Carlito", fontsize=10, color="#14213D"];

  Stub  [label="{\<\<generated\>\> RentalServiceServicer  (rental_pb2_grpc.py)|+ RentBook / SearchBooks / CheckStock\l+ ListActiveRentals / ReturnBook   (request, context)\l}", fillcolor="#F4F1EA"];
  Sync  [label="{RentalServicer  (sync_server.py)|+ catalog : BookCatalog\l+ manager : RentalManager\l+ delay : float\l|+ RentBook(request, context)\l+ SearchBooks(request, context)\l+ CheckStock(request, context)\l+ ListActiveRentals(request, context)\l+ ReturnBook(request, context)\l- _simulate_delay()   [time.sleep]\l}"];
  Async [label="{AsyncRentalServicer  (async_server.py)|+ catalog : BookCatalog\l+ manager : RentalManager\l+ delay : float\l|+ async RentBook(request, context)\l+ async SearchBooks(request, context)\l+ async CheckStock(request, context)\l+ async ListActiveRentals(request, context)\l+ async ReturnBook(request, context)\l- async _simulate_delay()   [asyncio.sleep]\l}", color="#0F8B8D", penwidth=2.2];
  Mgr [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#14213D" BGCOLOR="#E6EDF3"><TR><TD ALIGN="CENTER" SIDES="B">RentalManager</TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0">- _catalog : BookCatalog</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">- _active_rentals : dict</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">- _lock : Lock</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0">+ rent_book(student_id, book_id)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ return_book(rental_id)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ get_active_rentals(student_id)</TD></TR></TABLE></TD></TR></TABLE>>];
  Cat [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#14213D" BGCOLOR="#E6EDF3"><TR><TD ALIGN="CENTER" SIDES="B">BookCatalog</TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0">- _books : dict</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0">+ search_books(keyword)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ list_books()</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ check_stock(book_id)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ is_available(book_id)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ get_book(book_id)</TD></TR></TABLE></TD></TR></TABLE>>];

  {rank=same; Sync; Async;}
  {rank=same; Mgr; Cat;}

  Stub -> Sync  [dir=back, arrowtail=empty, arrowhead=none, label=" extends"];
  Stub -> Async [dir=back, arrowtail=empty, arrowhead=none, label=" extends"];
  Sync  -> Mgr  [dir=both, arrowtail=diamond, arrowhead=none];
  Async -> Mgr  [dir=both, arrowtail=diamond, arrowhead=none];
  Mgr -> Cat [dir=both, arrowtail=odiamond, arrowhead=none];
}
